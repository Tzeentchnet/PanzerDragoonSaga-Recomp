{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-x64",
      "displayName": "Windows x64 core builds (MSVC, Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/windows-msvc-x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;Shipping"
      }
    },
    {
      "name": "windows-msvc-x64-asan",
      "displayName": "Windows x64 Release with AddressSanitizer",
      "inherits": "windows-msvc-x64",
      "binaryDir": "${sourceDir}/out/build/windows-msvc-x64-asan",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "PDS_ENABLE_ASAN": true
      }
    },
    {
      "name": "windows-msvc-x64-tracy",
      "displayName": "Windows x64 Release with Tracy",
      "inherits": "windows-msvc-x64",
      "binaryDir": "${sourceDir}/out/build/windows-msvc-x64-tracy",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "PDS_ENABLE_TRACY": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-x64-debug",
      "displayName": "PDS - Debug",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Debug",
      "jobs": 4,
      "targets": [
        "PDS",
        "pds_tests"
      ]
    },
    {
      "name": "windows-msvc-x64-release",
      "displayName": "PDS - Release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release",
      "jobs": 4,
      "targets": [
        "PDS",
        "pds_tests"
      ]
    },
    {
      "name": "windows-msvc-x64-shipping",
      "displayName": "PDS - Shipping",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Shipping",
      "jobs": 4,
      "targets": [
        "PDS",
        "pds_tests"
      ]
    },
    {
      "name": "windows-msvc-x64-asan",
      "displayName": "PDS - Release with AddressSanitizer",
      "configurePreset": "windows-msvc-x64-asan",
      "configuration": "Release",
      "jobs": 4,
      "targets": [
        "PDS",
        "pds_tests"
      ]
    },
    {
      "name": "windows-msvc-x64-tracy",
      "displayName": "PDS - Release with Tracy",
      "configurePreset": "windows-msvc-x64-tracy",
      "configuration": "Release",
      "jobs": 4,
      "targets": [
        "PDS",
        "pds_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-x64-debug",
      "displayName": "Tests - Debug",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-msvc-x64-release",
      "displayName": "Tests - Release",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-msvc-x64-shipping",
      "displayName": "Tests - Shipping",
      "configurePreset": "windows-msvc-x64",
      "configuration": "Shipping",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-msvc-x64-asan",
      "displayName": "Tests - Release with AddressSanitizer",
      "configurePreset": "windows-msvc-x64-asan",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "windows-msvc-x64-tracy",
      "displayName": "Tests - Release with Tracy",
      "configurePreset": "windows-msvc-x64-tracy",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
